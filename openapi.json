{
  "openapi": "3.1.0",
  "info": {
    "title": "EZ Remote Agent",
    "description": "Installs, signs in and runs coding agents.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/agents": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "List agents",
        "description": "Returns every agent with its install and sign-in state.",
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Agents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentStatus"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/claude/settings": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "Get Claude Code settings",
        "operationId": "getClaudeSettings",
        "responses": {
          "200": {
            "description": "Settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaudeSettingsBody"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "agents"
        ],
        "summary": "Change Claude Code settings",
        "description": "Saves the settings, never downgrading the installed version and restarting Remote Control when its settings change.",
        "operationId": "updateClaudeSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaudeSettingsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaudeSettingsBody"
                }
              }
            }
          },
          "400": {
            "description": "A setting Claude cannot take",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/install": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Install or update an agent",
        "description": "Installs the newest release on the agent's release channel when it is newer than the installed one, and marks the agent configured.",
        "operationId": "installAgent",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentStatus"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The download or checksum failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/login": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Start signing in",
        "description": "Starts the agent's sign-in, replacing any unfinished one, and returns the link to open.",
        "operationId": "startAgentLogin",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sign-in started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginPrompt"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The agent is not installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The agent did not show a sign-in link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/login/code": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Finish Claude sign-in",
        "description": "Passes the code Claude shows after website sign-in to the waiting sign-in.",
        "operationId": "submitAgentLoginCode",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent, only claude takes a code",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in"
          },
          "400": {
            "description": "The agent does not take a code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "No sign-in is in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The sign-in did not finish",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/logout": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Sign the agent out",
        "description": "Signs the agent's CLI out of its account.",
        "operationId": "logOutAgent",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The agent is not installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The CLI could not sign out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/folders": {
      "get": {
        "tags": [
          "folders"
        ],
        "summary": "List the folders in /projects",
        "operationId": "listFolders",
        "responses": {
          "200": {
            "description": "Folders sorted by name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FolderStatus"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/folders/{name}/remote-control": {
      "put": {
        "tags": [
          "folders"
        ],
        "summary": "Choose whether the Claude app lists a folder",
        "description": "Starts or stops the folder's Remote Control server.",
        "operationId": "chooseToServeFolder",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "The folder's name in /projects",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Saved"
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/git": {
      "get": {
        "tags": [
          "git"
        ],
        "summary": "Get the GitHub sign-in and commit identity",
        "operationId": "getGitStatus",
        "responses": {
          "200": {
            "description": "Git status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitStatus"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/git/github/login": {
      "post": {
        "tags": [
          "git"
        ],
        "summary": "Start GitHub sign-in",
        "description": "Starts a device sign-in and returns the page to open and the code to enter there.",
        "operationId": "startGitHubLogin",
        "responses": {
          "200": {
            "description": "Sign-in started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginPrompt"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The sign-in comes from an environment variable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "gh did not start a sign-in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/git/github/logout": {
      "post": {
        "tags": [
          "git"
        ],
        "summary": "Sign git out of GitHub",
        "operationId": "logOutOfGitHub",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The sign-in comes from an environment variable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "gh could not sign out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/git/identity": {
      "put": {
        "tags": [
          "git"
        ],
        "summary": "Set the commit name and email",
        "description": "An empty or missing value removes it.",
        "operationId": "updateCommitIdentity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitIdentity"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitIdentity"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "git could not save it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Sign in",
        "description": "Checks the manager password and signs this browser in.",
        "operationId": "logIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in"
          },
          "401": {
            "description": "Wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "No password is set yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Sign out",
        "description": "Ends this browser's session.",
        "operationId": "logOut",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Session status",
        "description": "Returns whether a password is set and whether this request is signed in.",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Session status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Set the password",
        "description": "Sets the manager password when none is set yet, and signs this browser in.",
        "operationId": "setUpPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password set and signed in"
          },
          "400": {
            "description": "Empty password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "A password is already set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agent": {
        "type": "string",
        "description": "A command-line coding agent the manager can install and run.",
        "enum": [
          "claude",
          "codex"
        ]
      },
      "AgentStatus": {
        "type": "object",
        "description": "One agent's install and sign-in state.",
        "required": [
          "agent",
          "configured",
          "logged_in"
        ],
        "properties": {
          "account": {
            "type": [
              "string",
              "null"
            ],
            "description": "The signed-in account as the CLI reports it, absent when unknown."
          },
          "agent": {
            "$ref": "#/components/schemas/Agent"
          },
          "available_update": {
            "type": [
              "string",
              "null"
            ],
            "description": "A newer release than the installed version, absent when none is known."
          },
          "config_disk_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Bytes the agent keeps on /config, absent when they cannot be measured.",
            "minimum": 0
          },
          "configured": {
            "type": "boolean",
            "description": "Installed through the manager at least once."
          },
          "install_progress": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DownloadProgress",
                "description": "Present while an install or update is downloading."
              },
              {
                "type": "null"
              }
            ]
          },
          "installed_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent when the agent is not installed."
          },
          "logged_in": {
            "type": "boolean"
          },
          "login_prompt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoginPrompt",
                "description": "Present while a sign-in is waiting for the person signing in."
              },
              {
                "type": "null"
              }
            ]
          },
          "remote_control": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RemoteControlStatus",
                "description": "The Remote Control server, Claude Code only."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ClaudeSettingsBody": {
        "type": "object",
        "description": "How the manager installs, updates and serves Claude Code.",
        "required": [
          "release_channel",
          "remote_control"
        ],
        "properties": {
          "release_channel": {
            "$ref": "#/components/schemas/ReleaseChannel"
          },
          "remote_control": {
            "$ref": "#/components/schemas/RemoteControlSettings"
          }
        }
      },
      "CodeBody": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "CommitIdentity": {
        "type": "object",
        "description": "The name and email git writes into commits.",
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DownloadProgress": {
        "type": "object",
        "description": "How far a download has got.",
        "required": [
          "received_bytes"
        ],
        "properties": {
          "received_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes received so far.",
            "minimum": 0
          },
          "total_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Size of the download in bytes, absent when the server does not say.",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Why a request failed.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Folder": {
        "type": "object",
        "description": "One top-level folder in /projects.",
        "required": [
          "name"
        ],
        "properties": {
          "git": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GitDetails",
                "description": "Present when the folder is a git repository."
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "The folder's name in /projects."
          }
        }
      },
      "FolderStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Folder"
          },
          {
            "type": "object",
            "required": [
              "serve"
            ],
            "properties": {
              "remote_control": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/RemoteControlStatus",
                    "description": "The folder's Remote Control server, absent when it has none."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "serve": {
                "type": "boolean",
                "description": "Chosen to be served to the Claude app, by its own choice or by default."
              }
            }
          }
        ],
        "description": "A folder with what the Claude app sees of it."
      },
      "GitDetails": {
        "type": "object",
        "description": "Where a repository comes from and what it has checked out.",
        "properties": {
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "The checked-out branch, absent when not on a branch."
          },
          "repository": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where `origin` points, without credentials."
          }
        }
      },
      "GitHubStatus": {
        "type": "object",
        "description": "The GitHub sign-in git pushes with.",
        "required": [
          "signed_in",
          "failing",
          "from_environment"
        ],
        "properties": {
          "account": {
            "type": [
              "string",
              "null"
            ],
            "description": "The GitHub account, absent when unknown."
          },
          "failing": {
            "type": "boolean",
            "description": "An account is set up, but GitHub did not confirm it."
          },
          "from_environment": {
            "type": "boolean",
            "description": "Comes from `GH_TOKEN` or `GITHUB_TOKEN`, so sign-in and sign-out return 409."
          },
          "login_prompt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoginPrompt",
                "description": "Present while a sign-in waits for the person signing in."
              },
              {
                "type": "null"
              }
            ]
          },
          "signed_in": {
            "type": "boolean"
          }
        }
      },
      "GitStatus": {
        "type": "object",
        "description": "The GitHub sign-in and commit identity git uses.",
        "required": [
          "github",
          "identity"
        ],
        "properties": {
          "github": {
            "$ref": "#/components/schemas/GitHubStatus"
          },
          "identity": {
            "$ref": "#/components/schemas/CommitIdentity"
          }
        }
      },
      "LoginPrompt": {
        "type": "object",
        "description": "What the person signing in needs: a page to open, and sometimes a code to enter there.",
        "required": [
          "url"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The one-time code to enter on that page, when the sign-in uses one."
          },
          "url": {
            "type": "string",
            "description": "The sign-in page to open."
          }
        }
      },
      "PasswordBody": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "ReleaseChannel": {
        "type": "string",
        "description": "Which Claude Code releases to install: `latest` gets every release as soon as it ships,\n`stable` is about a week behind and skips releases with major regressions.",
        "enum": [
          "latest",
          "stable"
        ]
      },
      "RemoteControlSettings": {
        "type": "object",
        "description": "How Claude Code's Remote Control servers run.",
        "required": [
          "enabled",
          "permission_mode",
          "capacity",
          "serve_repositories"
        ],
        "properties": {
          "capacity": {
            "type": "integer",
            "format": "int32",
            "description": "The most sessions each server runs at once, from 1 to 32.",
            "default": 4,
            "maximum": 32,
            "minimum": 1
          },
          "enabled": {
            "type": "boolean",
            "description": "Serve /projects, and the folders chosen, to the Claude app while Claude Code is signed in.",
            "default": true
          },
          "permission_mode": {
            "type": "string",
            "description": "The permission mode for sessions started from the Claude app, such as `auto`.",
            "default": "auto"
          },
          "serve_repositories": {
            "type": "boolean",
            "description": "Serve the repositories in /projects that have no choice of their own.",
            "default": true
          }
        }
      },
      "RemoteControlStatus": {
        "type": "object",
        "description": "The manager's view of one Remote Control server.",
        "required": [
          "state",
          "restarts"
        ],
        "properties": {
          "device": {
            "type": [
              "string",
              "null"
            ],
            "description": "The device the Claude app lists this server under, the container's hostname."
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The end of the server's output when it last stopped unexpectedly."
          },
          "restarts": {
            "type": "integer",
            "format": "int32",
            "description": "Unexpected stops since the manager started.",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/ServerState"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where to continue in a browser, once connected."
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ServerUsage",
                "description": "What the server and its sessions use. Absent while no server process runs."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ServeBody": {
        "type": "object",
        "description": "Whether the Claude app lists a folder.",
        "required": [
          "serve"
        ],
        "properties": {
          "serve": {
            "type": "boolean"
          }
        }
      },
      "ServerState": {
        "type": "string",
        "description": "Where a Remote Control server is in its life.",
        "enum": [
          "off",
          "waiting",
          "starting",
          "running",
          "retrying"
        ]
      },
      "ServerUsage": {
        "type": "object",
        "description": "What a running server and its sessions use.",
        "required": [
          "sessions",
          "capacity",
          "memory_bytes"
        ],
        "properties": {
          "capacity": {
            "type": "integer",
            "format": "int32",
            "description": "The most sessions the server runs at once.",
            "minimum": 0
          },
          "memory_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Memory the server and its sessions use, with shared memory counted once.",
            "minimum": 0
          },
          "sessions": {
            "type": "integer",
            "format": "int32",
            "description": "Sessions running now.",
            "minimum": 0
          }
        }
      },
      "SessionStatus": {
        "type": "object",
        "required": [
          "claimed",
          "authenticated"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "This request carries a signed-in session."
          },
          "claimed": {
            "type": "boolean",
            "description": "A password has been set."
          }
        }
      }
    }
  }
}
