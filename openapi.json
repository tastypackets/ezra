{
  "openapi": "3.1.0",
  "info": {
    "title": "EZ Remote Agent",
    "description": "Installs, signs in and runs coding agents.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/agents": {
      "get": {
        "tags": [
          "agents"
        ],
        "summary": "List agents",
        "description": "Returns every agent with its install and sign-in state.",
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Agents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentStatus"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/install": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Install or update an agent",
        "description": "Installs the newest release, or updates to it, and marks the agent configured.",
        "operationId": "installAgent",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentStatus"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The download or checksum failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/login": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Start signing in",
        "description": "Starts the agent's sign-in, replacing any unfinished one, and returns the link to open.",
        "operationId": "startAgentLogin",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sign-in started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginPrompt"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The agent is not installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The agent did not show a sign-in link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/login/code": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Finish Claude sign-in",
        "description": "Passes the code Claude shows after website sign-in to the waiting sign-in.",
        "operationId": "submitAgentLoginCode",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent, only claude takes a code",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in"
          },
          "400": {
            "description": "The agent does not take a code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "No sign-in is in progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The sign-in did not finish",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{agent}/logout": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Sign the agent out",
        "description": "Signs the agent's CLI out of its account.",
        "operationId": "logOutAgent",
        "parameters": [
          {
            "name": "agent",
            "in": "path",
            "description": "The agent",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Agent"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "description": "Not signed in to the manager",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The agent is not installed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "The CLI could not sign out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Sign in",
        "description": "Checks the manager password and signs this browser in.",
        "operationId": "logIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in"
          },
          "401": {
            "description": "Wrong password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "No password is set yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Sign out",
        "description": "Ends this browser's session.",
        "operationId": "logOut",
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Session status",
        "description": "Returns whether a password is set and whether this request is signed in.",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Session status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Set the password",
        "description": "Sets the manager password when none is set yet, and signs this browser in.",
        "operationId": "setUpPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password set and signed in"
          },
          "400": {
            "description": "Empty password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "A password is already set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Agent": {
        "type": "string",
        "description": "A command-line coding agent the manager can install and run.",
        "enum": [
          "claude",
          "codex"
        ]
      },
      "AgentStatus": {
        "type": "object",
        "description": "One agent's install and sign-in state.",
        "required": [
          "agent",
          "configured",
          "logged_in"
        ],
        "properties": {
          "account": {
            "type": [
              "string",
              "null"
            ],
            "description": "The signed-in account as the CLI reports it, absent when unknown."
          },
          "agent": {
            "$ref": "#/components/schemas/Agent"
          },
          "available_update": {
            "type": [
              "string",
              "null"
            ],
            "description": "A newer release than the installed version, absent when none is known."
          },
          "config_disk_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Bytes the agent keeps on /config, absent when they cannot be measured.",
            "minimum": 0
          },
          "configured": {
            "type": "boolean",
            "description": "Installed through the manager at least once."
          },
          "install_progress": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DownloadProgress",
                "description": "Present while an install or update is downloading."
              },
              {
                "type": "null"
              }
            ]
          },
          "installed_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent when the agent is not installed."
          },
          "logged_in": {
            "type": "boolean"
          },
          "login_prompt": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoginPrompt",
                "description": "Present while a sign-in is waiting for the person signing in."
              },
              {
                "type": "null"
              }
            ]
          },
          "session_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Saved sessions, absent when they cannot be counted.",
            "minimum": 0
          }
        }
      },
      "CodeBody": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "DownloadProgress": {
        "type": "object",
        "description": "How far a download has got.",
        "required": [
          "received_bytes"
        ],
        "properties": {
          "received_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes received so far.",
            "minimum": 0
          },
          "total_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Size of the download in bytes, absent when the server does not say.",
            "minimum": 0
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Why a request failed.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "LoginPrompt": {
        "type": "object",
        "description": "What the person signing in needs: a link to open, and for Codex a code to type there.",
        "required": [
          "url"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "The one-time code to enter on that page, Codex only."
          },
          "url": {
            "type": "string",
            "description": "The sign-in page to open."
          }
        }
      },
      "PasswordBody": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "SessionStatus": {
        "type": "object",
        "required": [
          "claimed",
          "authenticated"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "This request carries a signed-in session."
          },
          "claimed": {
            "type": "boolean",
            "description": "A password has been set."
          }
        }
      }
    }
  }
}
