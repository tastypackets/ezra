{
  "name": "agent-box-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit --project e2e",
    "build": "pnpm check && esbuild src/app.ts src/app.css --bundle --minify --target=es2022 --outdir=dist",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
